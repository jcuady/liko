# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
build/
dist/

# Generated by Serwist at build time
public/sw.js
public/swe-worker-*.js
public/workbox-*.js

# Environment. `.env.local` holds development-only secrets and must never be
# committed. `.env.example` is the committed template.
.env
.env.local
.env*.local

# Supabase CLI local state, which can contain the database password.
.supabase/

# Test output
test-results/
playwright-report/
blob-report/
coverage/
.playwright/

# Responsive audit screenshots, regenerated by scripts/responsive-check.cjs
.responsive/

# graphify knowledge graph. Regenerate with `/graphify .`; the HTML and JSON are
# derived artefacts of a scan, not source. See docs/HANDOVER.md.
graphify-out/

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel / Next
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Klim Söhne fonts, kept locally for reference only. The bundled licence is
# "Personal Use Only" and the product ships Geist, so these binaries must never
# be redistributed through the repository.
sohne-font-family/

# Scratch files used by local probes and the brand-kit tool
.probe.cjs
.zprobe.cjs
.eprobe.cjs
.brandkit-args.json

# Captured Playwright output from a full-suite run, written when a failure has to
# be read in full rather than in the last screenful of a terminal.
.e2e-run.txt
.e2e-final.txt
.e2e-slot.txt
.e2e-slot2.txt
.e2e-fence.txt

# One-shot verification scripts used while porting the UI kit, not standing
# gates. They are written against the tree at the moment they run.
.class-check.mjs
.fix-displayname.mjs
.probe-radix.mjs
.probe-models.mjs

# Commit message written to a file and piped in with `git commit -F`. PowerShell
# mangles backticks and quotes inside a double-quoted argument, and this
# repository's messages are full of both.
.commit-msg.txt

# Vercel CLI link state. Holds the project and org id for this directory.
.vercel

# The supplied brand prototype. A separate Vite and TanStack Router project that
# happens to sit inside this repo; it is the reference the design was ported
# from, not part of the application. Excluded from TypeScript, ESLint, git and
# the Vercel build.
#
# All four have to agree on this list. It was missing from eslint.config.mjs, so
# `pnpm lint` had been reporting 18 errors and 7 warnings from files this product
# never builds, serves or ships.
Liko new landing/

# Session scratch: screenshot and completeness probes.
.live-shots.mjs

# Session scratch: screenshot and completeness probes.
.completeness.mjs
.live-*.png
