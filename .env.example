# LIKO environment
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# must never be committed. This file is the committed template and must never
# contain a real secret.
#
#   cp .env.example .env.local
#
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle.
# Everything else stays server-side. Never prefix a secret with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Project URL. Public.
NEXT_PUBLIC_SUPABASE_URL=https://ulrjitekiylgepdyijsw.supabase.co

# Publishable (anon) key. SAFE to expose to the browser by design: it grants
# only the `anon` role, and Row Level Security is what actually protects data.
# Never swap this for the secret key below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret (service_role) key. SERVER ONLY. Bypasses RLS entirely, so it must
# never be imported by any 'use client' module and must never be prefixed with
# NEXT_PUBLIC_. Used only by the push subscription and cron routes.
SUPABASE_SERVICE_ROLE_KEY=

# Database password, used only by the Supabase CLI for migrations.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------

# `supabase` | `fixtures`
#
# `fixtures` serves the built-in demo workspace so the marketing page, the hero
# mockups, and the Playwright suite run with no network and no database. Set to
# `supabase` for real data. No route may render fixtures while this is `supabase`.
LIKO_DATA_MODE=fixtures

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# HS256 signing key for the session JWS held in the httpOnly cookie.
# REQUIRED in production: the app throws at first use rather than falling back
# to a guessable development value.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LIKO_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Web push (VAPID)
# ---------------------------------------------------------------------------

# Public application server key. Safe to expose; the browser needs it to
# subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private application server key. SERVER ONLY. Anyone holding this can push to
# every subscribed user, so it must never be committed or shipped to the browser.
# Regenerate a fresh pair before launch if this one has ever been shared.
VAPID_PRIVATE_KEY=

# Sender used in the notification payload, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Site and scheduled jobs
# ---------------------------------------------------------------------------

# Absolute origin, used for metadata, canonical URLs, sitemap, and the
# email-verification and password-reset redirect targets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bearer token guarding POST /api/cron/at-risk. Without it the route is closed.
CRON_SECRET=